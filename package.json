{
  "name": "baduk-web",
  "version": "1.0.0",
  "private": true,
  "description": "A Dockerized Baduk web app deployed to AWS with CDK.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "predev": "npm run build:demo",
    "test": "node --test tests/server.test.js tests/infra.test.js",
    "pretest": "npm run build:demo",
    "build:demo": "esbuild public/demo/demo.js --bundle --platform=browser --outfile=public/demo/demo.bundle.js",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all --require-approval never",
    "precdk:deploy": "npm run build:demo"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.1029.0",
    "aws-cdk-lib": "^2.222.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tenuki": "^0.3.1"
  }
}
